<?xml version="1.0" encoding="utf-8"?>
<!-- Gestos, captura de tela e leitura do texto dos elementos (achar por texto). Nada é gravado nem enviado: o app não tem permissão de internet. isAccessibilityTool fica de fora de propósito: este app é automação, não tecnologia assistiva. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/service_desc"
    android:notificationTimeout="1000" />
