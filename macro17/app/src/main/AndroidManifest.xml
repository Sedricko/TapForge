<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Negada por padrão em instalações novas (API 33+); Alarms.kt cai para alarme aproximado. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Vibração curta junto do alarme de fim de macro (opção "Alarme"). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Não é concedida a apps comuns; declarada só para que `adb shell pm grant app.macro17 android.permission.READ_LOGS`
         libere o logcat do sistema inteiro no relatório de diagnóstico. -->
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />

    <application
        android:name=".App"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Macro17">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- configChanges: o editor guarda o estado em memória; evita perdê-lo ao girar a tela. -->
        <activity
            android:name=".EditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".OptionsActivity" android:exported="false" />
        <activity android:name=".PermissionsActivity" android:exported="false" />
        <activity android:name=".BackupActivity" android:exported="false" />
        <activity android:name=".FileManagerActivity" android:exported="false" />
        <activity android:name=".AddItemsActivity" android:exported="false" />
        <activity android:name=".AccessibilityAgreementActivity" android:theme="@android:style/Theme.DeviceDefault.Light.Dialog" android:exported="false" />
        <activity android:name=".PanelSettingsActivity" android:theme="@android:style/Theme.DeviceDefault.Light.Dialog" android:launchMode="singleTask" android:taskAffinity="" android:excludeFromRecents="true" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />
        <activity android:name=".AlarmListActivity" android:exported="false" />
        <activity android:name=".AlarmEditActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".FullScreenActivity" android:exported="false" android:excludeFromRecents="true" android:launchMode="singleInstance" android:showWhenLocked="true" android:turnScreenOn="true" />
        <activity android:name=".ItemEditorActivity" android:exported="false" />
        <activity android:name=".DiagActivity" android:theme="@style/Theme.Macro17.Dark" android:exported="false" />
        <activity android:name=".ReaderActivity" android:theme="@style/Theme.Macro17.Dark" android:exported="false" />

        <service
            android:name=".MacroService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
